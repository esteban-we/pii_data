# pii_data: git holds the ledger, OSS holds the bytes.
# Anything that can be downloaded again (images, checkpoints, exports) or
# re-rendered from a tracked source (the view manifests) stays out of git.

# Dataset pixels. frames.csv is the index of what belongs here.
/datasets/*/images/

# Views: recipe.yaml is the source, the rest is output of
# `python3 data/build_view.py render` in the pii repo.
/views/*/scrfd.txt
/views/*/d2.json
/views/*/summary.json

# Training runs: checkpoints, ONNX exports and the training logs.
# pick.yaml, the config files, models.csv and MANIFEST.tsv are tracked.
# Retention (PII-1601): OSS keeps every epoch of every arm, this disk keeps only
# the one epoch pick.yaml names in `pick_checkpoint:`. MANIFEST.tsv still has a
# row for each of the others, so `build_runs_pii2.py verify` and
# `oss_sync.py status` count them as on OSS, not missing, and
# `oss_sync.py pull --all-epochs --arm A` fetches one back.
/runs/train/*/*/epochs/
/runs/train/*/*/onnx/
/runs/train/*/*/logs/
/runs/train/*/*/train.log

# Model weights and archives anywhere in the tree, including runs/train/*/stock/.
# The .md5, .sha256 and .provenance.txt sidecars next to them stay tracked.
*.pth
*.onnx
*.jit
*.zip

# The faceight frame index is 102 MB of text, over GitHub's 100 MB blob limit
# (PII-1639). git tracks data/faceight/frames.csv.gz; readers open either through
# pii_root.open_index. Refresh the .gz after faceight_round.py rewrites the CSV:
#   gzip -9 -n -c data/faceight/frames.csv > data/faceight/frames.csv.gz
/data/faceight/frames.csv

# Population tables: 15 GB of parquet, OSS content.
/tables/population/

# Close-out chain state: the .done markers and summary.md of
# training/closeout/closeout_arm.sh in the pii repo, which PII-1682 moved here from
# the retired run tree. Progress of a run, not data.
/runs/closeout/

# Python bytecode: data/oss_sync.py is run from this checkout on every box.
__pycache__/
*.pyc
